MAPBOX_TOKEN=pk.eyJ1...your_mapbox_public_token_here
GFW_API_KEY=your_gfw_api_key_here
WEATHERAPI_KEY=your_weatherapi_key_here

# Google Earth Engine — required for the Land Cover (Dynamic World) insight.
# GEE_PROJECT_ID: a Google Cloud project registered at https://code.earthengine.google.com
# GEE_SERVICE_ACCOUNT_JSON: raw service-account key JSON, or an absolute path to the key file.
# Leave both blank to run without land-cover data (insight is reported as UNAVAILABLE).
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON=
